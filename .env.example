# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Shared secret for the Sanity publish webhook (/api/revalidate). Any long random
# string, e.g. `openssl rand -hex 24`. Must match the secret on the webhook in
# sanity.io/manage → API → Webhooks.
SANITY_REVALIDATE_SECRET=

# The live site's address, for absolute URLs in social previews.
NEXT_PUBLIC_SITE_URL=https://hilltophawk.com

# Optional: Sanity project ID and dataset default to the values in src/sanity/env.ts.
# NEXT_PUBLIC_SANITY_PROJECT_ID=2gccpec8
# NEXT_PUBLIC_SANITY_DATASET=production
